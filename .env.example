# Copy this file to .env and fill in your keys.
# AGENT=jev (default) needs only TYPESAFE_API_KEY; AGENT=claude needs the Anthropic vars.
AGENT=jev
TYPESAFE_API_KEY=

# Only for AGENT=claude. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Required only for identity-linked Anthropic API keys.
ANTHROPIC_WORKSPACE_ID=

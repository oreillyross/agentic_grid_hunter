# Copy this file to .env and fill in your keys.
# AGENT=jev (default) needs only TYPESAFE_API_KEY; claude/planner need the Anthropic vars;
# classic needs no key at all (BFS, no model). Append +nav (claude+nav) or set NAVIGATE=1
# to give Claude the navigate_to tool.
AGENT=jev
TYPESAFE_API_KEY=

# Only for AGENT=claude. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Required only for identity-linked Anthropic API keys.
ANTHROPIC_WORKSPACE_ID=

# Optional. Executor model (default claude-haiku-4-5) and Stage 6 planner model (default claude-sonnet-5-5).
# ANTHROPIC_MODEL=
# PLANNER_MODEL=
